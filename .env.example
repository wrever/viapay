# ViaPay API
PORT=3001
FEE_BPS=100
STELLAR_NETWORK=testnet
# simulated = el botón viejo /confirm sigue marcando pagado sin chain. onchain = exige XDR firmado.
STELLAR_MODE=onchain
# Circle USDC testnet. En mainnet usa GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
VIAPAY_API_PUBLIC_URL=http://localhost:3001
VIAPAY_TREASURY_ADDRESS=GDIN7HCR4PKKWS6MO57N7NF7VLGPO27GUQDR64TIK3CYRMPBCKUQDCT5
# Ops/demo only: treasury secret to open USDC trustline (never commit / never public Vercel).
# VIAPAY_TREASURY_SECRET_KEY=S…
#   node scripts/open-treasury-usdc-trustline.mjs
VIAPAY_CHECKOUT_URL=http://localhost:3000
VIAPAY_DATABASE_PATH=../../data/viapay.db
SEED_MERCHANT_WALLET=GAXLJHCMV6ZATLOI4SWBONOCS27KSBY55DGFNLWEM35NCU256OPBJMRS

# Public (dashboard / checkout en el mismo host) — local
NEXT_PUBLIC_VIAPAY_API_URL=http://localhost:3001
NEXT_PUBLIC_VIAPAY_CHECKOUT_URL=http://localhost:3000
NEXT_PUBLIC_VIAPAY_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_VIAPAY_WEB_URL=http://localhost:3000

# Production (Vercel). Sitio único = apps/dashboard → https://viapay.vercel.app
# Checkout del pagador: mismas rutas /pay/[id] en ese host (no otro proyecto UX).
# NEXT_PUBLIC_VIAPAY_WEB_URL=https://viapay.vercel.app
# NEXT_PUBLIC_VIAPAY_DASHBOARD_URL=https://viapay.vercel.app
# NEXT_PUBLIC_VIAPAY_API_URL=https://viapay-api.vercel.app
# NEXT_PUBLIC_VIAPAY_CHECKOUT_URL=https://viapay.vercel.app
# VIAPAY_API_PUBLIC_URL=https://viapay-api.vercel.app
# VIAPAY_CHECKOUT_URL=https://viapay.vercel.app

# OAuth Supabase (proyecto ViaPay: fcbdahduqesuotujqbez).
# NEXT_PUBLIC_SUPABASE_URL=https://fcbdahduqesuotujqbez.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_URL=https://fcbdahduqesuotujqbez.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # API + panel server; activa path Postgres en @viapay/api
# Ver docs/DEPLOY.md. Keys locales en .env.supabase.local (gitignored).
# Con SERVICE_ROLE en la API, Bearer OAuth y payment_intents usan el mismo Postgres.
# Sin SERVICE_ROLE, la API sigue en SQLite (VIAPAY_DATABASE_PATH).

# Contrato Soroban payment-router. Si está set, prepare/submit lo invoca (preferido).
# Vacío = split clásico multi-op.
# PAYMENT_ROUTER_CONTRACT_ID=CDI6XC5QTHOYUQQ2EU542OLA2ZB7ZP4PB5ANNX5YZO3FMBDPIAV7LPRT
# NEXT_PUBLIC_PAYMENT_ROUTER_CONTRACT_ID=CDI6XC5QTHOYUQQ2EU542OLA2ZB7ZP4PB5ANNX5YZO3FMBDPIAV7LPRT

# SEP-24. Dominio del anchor, sin https. ViaPay lee su stellar.toml.
# SDF Test Anchor (SEP-10/24 discovery). Fiat payout is simulated.
ANCHOR_HOME_DOMAIN=testanchor.stellar.org

# Trustless Work. Testnet: https://beta.api.trustlesswork.com
# TRUSTLESSWORK_API_KEY=
# TRUSTLESSWORK_API_URL=

# Wallet embebida Pollar en el checkout.
# NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Soroswap (plus): cotización / build / send XLM↔USDC en el panel.
# Key de https://api.soroswap.finance/login (empieza con sk_). Solo en la API — nunca NEXT_PUBLIC_.
# Deploy: Vercel proyecto **viapay-api** → Environment Variables → SOROSWAP_API_KEY
# SOROSWAP_API_KEY=
# Opcional: SOROSWAP_API_URL=https://api.soroswap.finance

# WhatsApp assistant — Meta Cloud API (sin Twilio). Solo en viapay-api.
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
# App + WhatsApp product → Phone number ID + permanent token + App Secret
# Webhook callback: https://viapay-api.vercel.app/v1/whatsapp/webhook
#   Verify token = META_WA_VERIFY_TOKEN (string que inventás vos)
#   Subscribe to: messages
# META_WA_ACCESS_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_VERIFY_TOKEN=
# META_APP_SECRET=
# Opcional: META_GRAPH_VERSION=v26.0
# Solo local/debug: META_WA_SKIP_SIGNATURE=1
# Cuando Meta publique la app: META_WA_APP_LIVE=1 (oculta aviso del panel)

# Email invoices — Resend (https://resend.com). Solo en viapay-api.
# Sin key: WhatsApp/panel usan mailto de fallback.
# RESEND_API_KEY=re_…
# RESEND_FROM_EMAIL=ViaPay <cobros@tudominio.com>   # dominio verificado en Resend
# (dev: podés usar onboarding@resend.dev como From)
